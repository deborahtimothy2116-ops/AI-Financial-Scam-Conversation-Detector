# Application Settings
PROJECT_NAME="AI Financial Scam Conversation Detector"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="temporary-super-secret-key-change-in-production-use-at-least-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database Configuration (PostgreSQL by default, falls back to SQLite if sqlite:/// is specified)
# For local Postgres: postgresql+psycopg2://postgres:postgres@localhost:5432/scam_detector
# For SQLite (default for easy out-of-the-box local run): sqlite:///./scam_detector.db
DATABASE_URL="sqlite:///./scam_detector.db"

# LLM Configuration
# Options: "openai", "gemini", "anthropic", "groq", "rule_based"
LLM_PROVIDER="rule_based"
LLM_MODEL="gpt-4o-mini"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""
LLM_TIMEOUT_SECONDS=15
LLM_FALLBACK_TO_RULE_BASED=True

# OCR Configuration
# Optional: Path to tesseract executable if not in system PATH (e.g. C:\Program Files\Tesseract-OCR\tesseract.exe on Windows or /usr/bin/tesseract on Linux)
TESSERACT_CMD=""
OCR_CONFIDENCE_THRESHOLD=50.0

# File Upload Security
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=["jpg", "jpeg", "png", "webp", "bmp"]
ALLOWED_IMAGE_MIME_TYPES=["image/jpeg", "image/png", "image/webp", "image/bmp"]

# CORS Settings (frontend origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]

# Rate Limiting & Safety
ALLOW_GUEST_SCANS=True
MAX_TEXT_LENGTH_CHARS=20000
